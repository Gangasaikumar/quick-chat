{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "frontend:start (vite)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/front-end/src",
            "preLaunchTask": "frontend:npm-dev",
            "skipFiles": [
                "**/node_modules/**",
                "**/vite/**",
                "**/react/**",
                "**/@react-refresh/**"
            ]
        }
    ]
}